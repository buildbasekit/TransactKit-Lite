# Copy this file to .env and uncomment only the values you want to override.
# The application starts with H2 and without Stripe when .env is absent.

# Stripe test mode
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_SUCCESS_URL=http://localhost:8080/api-test/success.html
# STRIPE_CANCEL_URL=http://localhost:8080/api-test/cancel.html

# Local stripe-mock contract testing only (never set this in production)
# STRIPE_API_BASE=http://localhost:12111

# External MySQL database (omit to keep the default in-memory H2 database)
# DB_URL=jdbc:mysql://localhost:3306/transactkit_lite
# DB_USERNAME=your_database_username
# DB_PASSWORD=your_database_password

# Graceful-shutdown override
# SHUTDOWN_TIMEOUT=30s
